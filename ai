#!/usr/bin/env python3
"""Route a coding task to whichever vendor CLI still has quota headroom.

    ai                     show status and which agent would be picked
    ai "fix the flaky test in test_router.py"
    ai -p "summarise the diff on this branch"
    ai --agent codex "port this module to async"
"""

import argparse
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from dispatcher import launch as launcher
from dispatcher.config import load_config
from dispatcher.routing import choose_agent, plan_wait

USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def paint(text, code):
    return f"\033[{code}m{text}\033[0m" if USE_COLOR else text


def green(t):
    return paint(t, "32")


def red(t):
    return paint(t, "31")


def dim(t):
    return paint(t, "2")


def bold(t):
    return paint(t, "1")


def plan_of(services, agent):
    service = services.get(agent)
    plan = service.get("plan") if isinstance(service, dict) else None
    return str(plan) if plan else "-"


def print_status(services, decision):
    print(bold("usage-tracker dispatcher"))
    print()
    for a in decision.assessments:
        state = green("eligible") if a.eligible else red("blocked ")
        headroom = f"{a.headroom:5.1f}%" if a.headroom is not None else f"{'-':>6}"
        plan = plan_of(services, a.agent)
        print(f"  {a.agent:<8} {plan:<8} {state}  headroom {headroom}")
        print(f"  {'':<8} {dim(a.reason)}")
        print()

    if decision.agent:
        print(f"{green('→')} would dispatch to: {bold(decision.agent)} ({decision.reason})")
    else:
        print(f"{red('→')} would dispatch to: nothing available ({decision.reason})")


def parse_args(argv):
    parser = argparse.ArgumentParser(
        prog="ai",
        description="Dispatch a coding task to the AI CLI with the most quota left.",
    )
    parser.add_argument("task", nargs="*", help="the task to hand to the agent")
    parser.add_argument("--status", action="store_true",
                        help="show agent status and the routing decision, then exit")
    parser.add_argument("--ps", action="store_true",
                        help="list dispatches currently in flight and exit")
    parser.add_argument("-p", "--print", dest="headless", action="store_true",
                        help="headless mode: run the task non-interactively and print the result")
    parser.add_argument("--agent", choices=sorted(launcher.AGENT_COMMANDS),
                        help="skip routing and use this agent")
    parser.add_argument("--no-journal", dest="journal", action="store_false",
                        help="do not read from or write to SESSION.md")
    parser.add_argument("--now", action="store_true",
                        help="dispatch immediately, even if it spends reserve "
                             "(e.g. cursor) credits instead of waiting for a "
                             "rate-limit window to reset")
    return parser.parse_args(argv)


def fmt_elapsed(seconds):
    s = int(max(0, seconds))
    if s < 60:
        return f"{s}s"
    m, rs = divmod(s, 60)
    if m < 60:
        return f"{m}m {rs:02d}s"
    h, rm = divmod(m, 60)
    if h < 24:
        return f"{h}h {rm:02d}m"
    d, rh = divmod(h, 24)
    return f"{d}d {rh:02d}h"


def print_active():
    _, active = launcher.read_dispatch_log(limit=1000)
    if not active:
        print("no dispatches in flight")
        return 0
    print(bold("in flight:"))
    for row in active:
        agent = row.get("agent", "?")
        repo = row.get("repo") or "-"
        elapsed = fmt_elapsed(row.get("elapsed_s") or 0)
        task = row.get("task") or ""
        pid = row.get("pid") or "?"
        mode = row.get("mode") or "?"
        print(f"  {agent:<7} {repo:<20} {elapsed:>10}  {dim(f'pid {pid} · {mode}')}")
        if task:
            print(f"          {dim(task)}")
    return 0


def sleep_until(resume_at):
    """Chunked sleep with a countdown when attached to a terminal."""
    while True:
        remaining = resume_at - time.time()
        if remaining <= 0:
            break
        if sys.stdout.isatty():
            print(f"\r  resuming in {int(remaining // 60)}m {int(remaining % 60):02d}s ",
                  end="", flush=True)
        time.sleep(min(30, max(1, remaining)))
    if sys.stdout.isatty():
        print()


def wait_for_reset(plan, config, installed):
    """Sleep through the quota break, then re-route with fresh usage data.

    Returns the new Decision, or None if agents are still blocked after the
    grace period.
    """
    wait_cfg = config.get("wait") or {}
    reserve = set(config.get("reserve") or [])
    resume_at = plan.resume_at + 60  # small buffer for the vendor to roll over

    when = time.strftime("%I:%M %p", time.localtime(resume_at)).lstrip("0")
    minutes = max(1, int((resume_at - time.time()) / 60))
    print(f"quota break: {plan.waiting_for}'s rate-limit window resets around {when} "
          f"(~{minutes} min). Waiting instead of spending {', '.join(sorted(reserve))} "
          f"credits — Ctrl+C to stop, or rerun with --now to dispatch immediately.",
          flush=True)
    sleep_until(resume_at)

    grace_s = float(wait_cfg.get("grace_minutes") or 10) * 60
    poll_s = float(wait_cfg.get("poll_seconds") or 120)
    deadline = time.time() + grace_s
    while True:
        services = launcher.fetch_usage(config, force=True)
        decision = choose_agent(services, config, installed)
        assessed = {a.agent: a for a in decision.assessments}
        chosen = assessed.get(decision.agent)
        if (decision.agent and decision.agent not in reserve
                and chosen is not None and chosen.eligible):
            print(f"window reset — resuming with {decision.agent}", flush=True)
            return decision
        if time.time() >= deadline:
            return None
        time.sleep(poll_s)


def main(argv=None):
    args = parse_args(argv)
    task = " ".join(args.task).strip()

    if args.ps:
        return print_active()

    config = load_config()
    services = launcher.fetch_usage(config)
    installed = launcher.installed_agents()
    decision = choose_agent(services, config, installed, override=args.agent)

    if args.status or not task:
        print_status(services, decision)
        return 0

    if not args.now and args.agent is None:
        plan = plan_wait(decision, config)
        if plan:
            decision = wait_for_reset(plan, config, installed)
            if decision is None:
                print("still rate-limited after the window reset; rerun with --now "
                      "to spend reserve credits anyway", file=sys.stderr)
                return 1

    if decision.agent is None:
        print(f"no agent available: {decision.reason}", file=sys.stderr)
        return 1

    # flush now so this lands before the agent's own output when stdout is a pipe
    print(f"dispatching to {bold(decision.agent)} ({decision.reason}) ...", flush=True)
    return launcher.launch(decision.agent, task, args.headless, args.journal,
                           reason=decision.reason, forced=args.agent is not None)


if __name__ == "__main__":
    sys.exit(main())
